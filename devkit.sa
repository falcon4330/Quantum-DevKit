# @use ./lib/ui.sa
# @use ./lib/codec.sa
# @use ./lib/text.sa
# @use ./lib/numbers.sa
# @use ./lib/jsonutil.sa

# Quantum DevKit — main entry and menu loop

fn run_base64_encode() {
  print("")
  print("--- Base64 Encoder ---")
  text = prompt("Enter text to encode: ")
  try {
    result = do_base64_encode(text)
    print("Result: " + result)
  } catch (e) {
    show_error(e)
  }
  pause()
}

fn run_base64_decode() {
  print("")
  print("--- Base64 Decoder ---")
  text = prompt("Enter Base64 to decode: ")
  try {
    result = do_base64_decode(text)
    print("Result: " + result)
  } catch (e) {
    show_error(e)
  }
  pause()
}

fn run_url_encode() {
  print("")
  print("--- URL Encoder ---")
  text = prompt("Enter text to URL-encode: ")
  try {
    result = do_url_encode(text)
    print("Result: " + result)
  } catch (e) {
